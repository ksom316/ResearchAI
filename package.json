{
  "name": "research-ai",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "worker": "tsx --env-file=.env.worker worker/index.ts",
    "worker:once": "tsx --env-file=.env.worker worker/index.ts --once",
    "worker:drain": "tsx --env-file=.env.worker worker/index.ts --drain",
    "worker:evidence": "tsx --env-file=.env.worker worker/evidence-worker.ts",
    "worker:evidence:once": "tsx --env-file=.env.worker worker/evidence-worker.ts --once",
    "worker:evidence:drain": "tsx --env-file=.env.worker worker/evidence-worker.ts --drain",
    "embedding:smoke": "tsx --env-file=.env.worker worker/embedding-smoke.ts",
    "embedding:index": "tsx --env-file=.env.worker worker/embedding-index.ts",
    "embedding:index:dry": "tsx --env-file=.env.worker worker/embedding-index.ts --dry-run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260903-beta",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
