# Local PDF processing worker (npm run worker). SERVER-ONLY secrets.
# Copy to .env.worker (gitignored). NEVER prefix these with VITE_ and never put
# them in .env, Vercel client variables, or any code that ships to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> service_role / secret key. Bypasses RLS: keep private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tuning (defaults shown)
# WORKER_POLL_INTERVAL_MS=10000
# WORKER_MAX_ATTEMPTS=3
# WORKER_STALE_AFTER_MINUTES=15
# WORKER_JOB_TIMEOUT_MS=120000
# WORKER_MAX_PDF_BYTES=62914560

# --- Embeddings (Phase 4). Used by `npm run embedding:smoke` and the future embedding stage.
# Voyage AI key. SERVER-ONLY: never a VITE_ variable, never committed. Locked to
# voyage-4 / 1024 dimensions for Phase 4 (the database column is vector(1024)).
EMBEDDING_API_KEY=your-voyage-api-key
# Optional tuning (defaults shown). Model and dimensions are locked; setting them to
# anything else is refused.
# EMBEDDING_MODEL=voyage-4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_MS=30000
# EMBEDDING_MAX_ATTEMPTS=4
