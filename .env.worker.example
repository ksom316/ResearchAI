# Local PDF processing worker (npm run worker). SERVER-ONLY secrets.
# Copy to .env.worker (gitignored). NEVER prefix these with VITE_ and never put
# them in .env, Vercel client variables, or any code that ships to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> service_role / secret key. Bypasses RLS: keep private.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional tuning (defaults shown)
# WORKER_POLL_INTERVAL_MS=10000
# WORKER_MAX_ATTEMPTS=3
# WORKER_STALE_AFTER_MINUTES=15
# WORKER_JOB_TIMEOUT_MS=120000
# WORKER_MAX_PDF_BYTES=62914560
