# Supabase project settings (Project Settings -> API).
# Only the public anon key belongs here. Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The PDF worker's service-role key is NOT configured here.
# Copy the tracked .env.worker.example template to .env.worker, which is gitignored.

# Phase 5 chat LLM (OpenRouter). SERVER-ONLY: never use a VITE_ prefix.
# Set real values in .env.local (gitignored), not here.
OPENROUTER_API_KEY=
LLM_MODEL=openrouter/free
LLM_STRUCTURED_MODE=json_schema
# json_schema (default) or json_object, for models that return JSON without enforcing a schema.

# Semantic query embeddings for authenticated web search/Chat. SERVER-ONLY.
# The persistent worker uses the same variable name in .env.worker.
EMBEDDING_API_KEY=your-voyage-api-key
